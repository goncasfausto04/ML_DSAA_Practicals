      "column": "14 numeric columns",
      "action": "NO outlier treatment",
      "reason": "five rules were compared and none earned its place; dropping rows by the 1.5*IQR rule removes 67.33% of the file and moves the win rate from 0.6040 to 0.3933, because the rows it deletes win at 0.7063, so it preferentially deletes the signal; on identical held-out rows it scores +0.0022 +/- 0.0045 against keeping everything, half a standard error, so the score does not separate them and the row count and the class rate decide",
      "rows_affected": 0,
      "carries": {
        "applied": false,
        "outliers": "keep",
        "rule_tested": "IQR k=1.5"
      }
    },
