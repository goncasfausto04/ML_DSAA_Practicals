    {
      "column": "11 training-volume columns",
      "action": "log1p, and log1p on nothing else",
      "reason": "measured over 20 paired splits on identical held-out rows: F1 0.8506 against 0.8182 untouched, a paired +0.0325 +/- 0.0030, better on 20 of 20; these columns are right-skewed by factors of 1.57 to 3.06, and log1p is stateless, so there is nothing to fit and therefore nothing to leak",
      "rows_affected": 11,
      "carries": {
        "applied": false,
        "transform": "log1p",
        "columns": [
          "Train bf competition",
          "Strength training",
          "Sand training",
