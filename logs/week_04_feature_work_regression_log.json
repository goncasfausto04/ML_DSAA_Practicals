{
  "dataset": "cars4you",
  "steps": [
    {
      "column": "Brand, transmission, fuelType",
      "action": "drop rows whose value is not one of the canonical spellings",
      "reason": "a keystroke slip or a clipped word is not a category of its own, and there is no damaged cell here to repair back to -- these rows are, almost always, cars the spine draw never selected",
      "rows_affected": 531,
      "carries": {
        "treatment": "drop",
        "canon": {
          "Brand": [
            "Audi",
            "BMW",
            "Ford",
            "Hyundai",
            "Mercedes",
            "Opel",
            "Skoda",
            "Toyota",
            "VW"
          ],
          "transmission": [
            "Automatic",
            "Manual",
            "Other",
            "Semi-Auto",
            "Unknown"
          ],
          "fuelType": [
            "Diesel",
            "Electric",
            "Hybrid",
            "Other",
            "Petrol"
          ]
        }
      }
    },
    {
      "column": "year, mileage, tax, mpg, engineSize, paintQuality%, previousOwners, price",
      "action": "drop rows holding a value the column's own domain forbids; a missing value is left alone",
      "reason": "a negative distance or a fractional owner cannot be repaired without inventing the number, while an empty cell is unknown rather than wrong and is filled later, inside a training fold",
      "rows_affected": 86,
      "carries": {
        "treatment": "drop",
        "missing_values": "left open"
      }
    },
    {
      "column": "all 12 columns",
      "action": "drop the union of the two rules above",
      "reason": "measured against repairing the spellings, dropping costs 12.82 EUR of mean absolute error, nearly five standard errors and 10 of 10 draws; it is recorded here because this file is indexed positionally by every later week, so its length is fixed, and the cost of that is a number rather than an assertion",
      "rows_affected": 600,
      "carries": {
        "treatment": "drop",
        "cost_eur": 14.46,
        "rows_out": 4000,
        "dtypes": {
          "year": "Int64",
          "previousOwners": "Int64"
        }
      }
    },
    {
      "column": "11 feature columns",
      "action": "missing values LEFT OPEN; the 'median / own level' plan goes to later weeks",
      "reason": "a median computed here would be computed over the rows each later week holds out to score on, so the file would carry a value derived from its own test set; the plan won the comparison above and each week applies it inside its own split",
      "rows_affected": 1537,
      "carries": {
        "applied": false,
        "fill": {
          "numeric": "median",
          "categorical": "own level"
        },
        "numeric": [
          "year",
          "mileage",
          "tax",
          "mpg",
          "engineSize",
          "paintQuality%",
          "previousOwners"
        ],
        "categorical": [
          "Brand",
          "model",
          "transmission",
          "fuelType"
        ]
      }
    },
    {
      "column": "mpg, mileage",
      "action": "log1p, and log1p on nothing else",
      "reason": "measured column by column against ten folds: mpg earns -44.11 EUR +/- 5.40 while engineSize costs +109.98 +/- 6.24 and year +384.87 +/- 16.12, and the plausible blanket rules lose, 'every skewed column' by +84.68 and 'all seven' by +79.95; tax at -2.79 +/- 0.87 and mileage at +7.85 +/- 14.43 are inside the 111 EUR the choice of split moves, so the score cannot separate them and the raw range does: mileage spans 150,000 against tax's 580, and a column that wide governs every distance and every first gradient step taken before scaling; taking mileage rather than tax costs 21.14 EUR here and is the same recipe in every week that inherits it",
      "rows_affected": 2,
      "carries": {
        "applied": false,
        "transform": "log1p",
        "columns": [
          "mpg",
          "mileage"
        ],
        "rejected": [
          "engineSize",
          "year",
          "tax",
          "paintQuality%",
          "previousOwners"
        ]
      }
    },
    {
      "column": "7 numeric columns",
      "action": "NO outlier treatment",
      "reason": "the IQR rule at k=1.5 removes 29.43% of the file, 1,043 rows on tax alone because 44.8% of cars sit at exactly 145 and the box is 20 euros wide; what it deletes is not a random third, the rows it keeps average 18,442 EUR against 12,617 for the rows it deletes, so it deletes the cheap end of the market the model will be asked about",
      "rows_affected": 0,
      "carries": {
        "applied": false,
        "outliers": "keep",
        "rule_tested": "IQR k=1.5"
      }
    },
    {
      "column": "the design matrix",
      "action": "NO scaler",
      "reason": "measured over ten folds, the four candidates agree on MAE to within 1.32 EUR against a standard error of about 40, because ordinary least squares on a full-rank design is scale-invariant in fit; cond(X) does fall from 4.312e+07 to 12.75, which is a fact about the solve and not about the score, and a model that is not scale-invariant has to measure this again for itself",
      "rows_affected": 0,
      "carries": {
        "applied": false,
        "scaler": null,
        "reason": "OLS is scale-invariant in fit",
        "conditioning": {
          "none": 43120000.0,
          "standard": 12.75
        }
      }
    },
    {
      "column": "all 10 feature columns",
      "action": "selected the one-hot + min-max combination: one-hot encoding and min-max scaling, both fitted inside each training split",
      "reason": "lowest mean held-out MAE among the sixteen combinations of the four encoders and the four Week 3 scalers; Ridge is penalised and so not scale-invariant, which is the re-measurement the Week 3 'NO scaler' entry asks for",
